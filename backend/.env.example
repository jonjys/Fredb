# =============================================================================
# TRADING BOT — BACKEND ENVIRONMENT VARIABLES
# Copy this file to ".env" for local development.
# In production (Railway/Render) set these as Environment Variables in the
# dashboard — NEVER commit a real .env file.
# =============================================================================

# --- Runtime mode -----------------------------------------------------------
# paper   = fully simulated wallet & fills, uses REAL public market data.
#           No API keys required. SAFE. Use this first, always.
# testnet = trades against the exchange's official testnet with test funds.
#           Requires testnet API keys (see README for how to get them).
# live    = REAL MONEY. Only switch to this after paper + testnet have run
#           cleanly for at least a few days and you understand the risk.
BOT_MODE=paper

# Exchange to trade on. Must be a valid ccxt exchange id.
# Primary: binance | Secondary: coinbase
EXCHANGE_ID=binance

# Comma-separated list of symbols to scalp, ccxt unified format.
SYMBOLS=BTC/USDT,ETH/USDT

# Candle timeframe used for signal generation.
TIMEFRAME=1m

# --- Binance API credentials -------------------------------------------------
# Start with READ-ONLY keys to verify the bot behaves correctly, then upgrade
# to trading-enabled keys. NEVER enable withdrawal permission on bot keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Coinbase API credentials ------------------------------------------------
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSWORD=

# --- Risk management (recommended conservative defaults) --------------------
MAX_RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_POSITIONS=3
TAKE_PROFIT_PCT=0.6
TRAILING_STOP_PCT=0.3
STOP_LOSS_PCT=0.4
ATR_MULTIPLIER=1.5
MAX_DAILY_LOSS_PCT=5.0
TAKER_FEE_PCT=0.1
SLIPPAGE_BUFFER_PCT=0.05

# Starting paper-trading balance (quote currency, e.g. USDT), ignored in
# testnet/live mode.
PAPER_STARTING_BALANCE=1000

# How often the strategy loop evaluates each symbol, in seconds.
POLL_INTERVAL_SECONDS=5

# --- Futures (leveraged) trading ---------------------------------------------
# Opt-in and OFF by default. Runs as a second, independent bot alongside the
# spot one above (own settings, own state, own kill switch) against Binance
# USDT-M perpetual futures. Risk per trade is capped the same way regardless
# of leverage — leverage only changes margin efficiency, and requested
# leverage is always clamped down (never up) so the stop-loss fires before
# the exchange's liquidation engine would. Read docs/RISK_SETTINGS.md before
# enabling, and start with FUTURES_MODE=paper.
FUTURES_ENABLED=false
FUTURES_MODE=paper

# Symbol selection: "dynamic" auto-scans the top FUTURES_DYNAMIC_TOP_N most
# liquid USDT-M perpetuals by 24h volume (not limited to BTC/ETH — any pair
# with enough real volume becomes tradeable automatically). "fixed" uses the
# literal FUTURES_SYMBOLS list below instead.
FUTURES_SYMBOL_MODE=dynamic
FUTURES_DYNAMIC_TOP_N=10
# Liquidity floor for the dynamic scan (24h USDT volume) — the main guard
# against trading thin, easily-manipulated markets with leverage.
FUTURES_MIN_24H_VOLUME_USD=5000000
# Only used when FUTURES_SYMBOL_MODE=fixed.
FUTURES_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT

FUTURES_LEVERAGE_DEFAULT=5
FUTURES_MAX_LEVERAGE=50
FUTURES_PAPER_STARTING_BALANCE=1000

# --- Dashboard / API security -------------------------------------------------
# Random long secret used to authenticate the frontend against this backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=change-me-to-a-long-random-secret

# Comma-separated list of allowed CORS origins (your Vercel frontend URL).
CORS_ORIGINS=http://localhost:3000

# --- Persistence & logging ----------------------------------------------------
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO

# Port the API server listens on (Railway/Render inject PORT automatically).
PORT=8000
