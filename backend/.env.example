# .env.example
# =============================================================================
# TRADING BOT — BACKEND ENVIRONMENT VARIABLES
# Copy this file to ".env" for local development.
# In production (Railway/Render) set these as Environment Variables in the
# dashboard — NEVER commit a real .env file.
# =============================================================================

# --- Runtime mode -----------------------------------------------------------
# paper   = fully simulated wallet & fills, uses REAL public market data.
#           No API keys required. SAFE. Use this first, always.
# testnet = trades against the exchange's official testnet with test funds.
#           Requires testnet API keys (see README for how to get them).
# live    = REAL MONEY. Only switch to this after paper + testnet have run
#           cleanly for at least a few days and you understand the risk.
BOT_MODE=paper

# Exchange to trade on. Must be a valid ccxt exchange id.
# Primary: binance | Secondary: coinbase
EXCHANGE_ID=binance

# Comma-separated list of symbols to scalp, ccxt unified format. Kept to
# ultra-liquid pairs only — a leveraged mean-reversion engine is exactly the
# setup most exposed to thin-book slippage.
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Candle timeframe used for signal generation.
TIMEFRAME=1m

# --- Binance API credentials -------------------------------------------------
# Start with READ-ONLY keys to verify the bot behaves correctly, then upgrade
# to trading-enabled keys. NEVER enable withdrawal permission on bot keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Coinbase API credentials ------------------------------------------------
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSWORD=

# --- Risk management (recommended conservative defaults) --------------------
MAX_RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_POSITIONS=3
# TAKE_PROFIT_PCT must clear round_trip_cost_pct() * MIN_TP_COST_MULTIPLE —
# see app/risk.py's is_take_profit_worth_it(), checked at bot startup.
TAKE_PROFIT_PCT=0.6
TRAILING_STOP_PCT=0.25
STOP_LOSS_PCT=0.35
# Trailing activates at this unrealized gain (independent of TAKE_PROFIT_PCT).
TRAILING_ACTIVATE_PCT=0.4
ATR_MULTIPLIER=1.5
MAX_DAILY_LOSS_PCT=5.0
TAKER_FEE_PCT=0.1
SLIPPAGE_BUFFER_PCT=0.05

# Starting paper-trading balance (quote currency, e.g. USDT), ignored in
# testnet/live mode.
PAPER_STARTING_BALANCE=1000

# How often the strategy loop evaluates each symbol, in seconds.
POLL_INTERVAL_SECONDS=5

# --- Execution quality (app/exchange.py) --------------------------------------
# How long a single post-only attempt waits for a fill before being
# cancelled and re-quoted (see POST_ONLY_MAX_RETRIES) — tightened for a
# faster in/out cadence.
POST_ONLY_TIMEOUT_SECONDS=4
# On an unfilled post-only entry, cancel and repost this many times,
# chasing a tick further into the spread each attempt (still strictly
# postOnly/GTX — never crosses the spread to force a taker fill).
POST_ONLY_MAX_RETRIES=2
# An entry fill's fee rate exceeding maker_fee_pct by this multiple gets
# logged as TAKER_LEAKAGE and alerted — should structurally never fire.
TAKER_LEAKAGE_FEE_MULTIPLE=1.2

# --- Volatility-aware risk throttle + notional cap (app/risk.py) -------------
HIGH_VOLATILITY_ATR_PCT=1.5
HIGH_VOLATILITY_RISK_MULTIPLIER=0.5
MAX_NOTIONAL_PCT_OF_EQUITY=0.20

# --- Regime filters (app/regime.py) -------------------------------------------
# Require the order book to be this strongly confirming before entering
# (2.0 = bids must outweigh asks 2:1 for a long; a short needs the mirror,
# asks outweighing bids 2:1). High-conviction entry confirmation, trading
# frequency for win rate — raise for stricter, lower for more trades.
REGIME_ORDERBOOK_IMBALANCE_MIN=2.0
REGIME_ORDERBOOK_DEPTH_LEVELS=5
# Skip entries when the touch spread is this wide (%) — thin/uncertain
# liquidity and less likely to fill without chasing further than intended.
REGIME_MAX_SPREAD_PCT=0.03
# Skip a long when funding is elevated positive (crowded/expensive to hold
# long), and the mirror for shorts. Raw fraction as ccxt's
# fetch_funding_rate returns it (0.0003 = 0.03% per 8h interval — Binance
# funding typically runs -0.01% to +0.03%, so this is "meaningfully
# elevated," not an extreme that rarely fires). Futures only.
REGIME_FUNDING_EXTREME_THRESHOLD=0.0003
REGIME_FUNDING_CACHE_SECONDS=60
# BTC dominance move filter, sourced free/no-key from CoinGecko. Fails open
# (gate skipped, not blocked) on any fetch error.
REGIME_BTC_DOMINANCE_ENABLED=true
REGIME_BTC_DOMINANCE_MOVE_THRESHOLD_PCT=0.5
REGIME_BTC_DOMINANCE_REFRESH_SECONDS=900

# --- Futures (leveraged) trading ---------------------------------------------
# Opt-in and OFF by default. Runs as a second, independent bot alongside the
# spot one above (own settings, own state, own kill switch) against Binance
# USDT-M perpetual futures. Risk per trade is capped the same way regardless
# of leverage — leverage only changes margin efficiency, and requested
# leverage is always clamped down (never up) so the stop-loss fires before
# the exchange's liquidation engine would. Read docs/RISK_SETTINGS.md before
# enabling, and start with FUTURES_MODE=paper.
FUTURES_ENABLED=false
FUTURES_MODE=paper

# Symbol selection: "fixed" (the default) trades only the literal
# FUTURES_SYMBOLS list below — ultra-liquid pairs only, deliberately, since
# leverage + mean reversion is exactly the setup that gets hurt most by thin
# altcoin slippage. "dynamic" instead auto-scans the top FUTURES_DYNAMIC_TOP_N
# most liquid USDT-M perpetuals by 24h volume if you want that back.
FUTURES_SYMBOL_MODE=fixed
FUTURES_DYNAMIC_TOP_N=10
# Liquidity floor for the dynamic scan (24h USDT volume) — the main guard
# against trading thin, easily-manipulated markets with leverage.
FUTURES_MIN_24H_VOLUME_USD=50000000
# The dynamic scan only considers base assets on the curated allowlist in
# backend/app/exchange.py (KNOWN_CRYPTO_BASE_ASSETS) — this excludes
# tokenized-stock/commodity perpetuals Binance lists under the same market
# shape as crypto. Add a comma-separated list here if a legitimate coin
# isn't already on that allowlist; leave empty otherwise.
FUTURES_EXTRA_ALLOWED_SYMBOLS=
# Explicit blacklist applied to the dynamic scan only (never to the fixed
# FUTURES_SYMBOLS list below, which is an explicit, deliberate choice) —
# high-volatility pairs excluded even if they clear the volume floor.
FUTURES_EXCLUDED_SYMBOLS=ZEC/USDT:USDT,NEAR/USDT:USDT,UNI/USDT:USDT,LUNC/USDT:USDT
# Only used when FUTURES_SYMBOL_MODE=fixed.
FUTURES_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT

FUTURES_LEVERAGE_DEFAULT=5
FUTURES_MAX_LEVERAGE=20
FUTURES_PAPER_STARTING_BALANCE=1000

# --- Push notifications (app/notifications.py) --------------------------------
# Critical-event alerts (circuit breaker activated, daily loss limit hit,
# excessive slippage on a stop/trailing-stop close) sent to Discord and/or
# Telegram. Both are optional and independent — set either, both, or leave
# empty to disable notifications entirely.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A stop/trailing-stop fill more than this far (in %) from the level it was
# supposed to trigger at gets flagged as an alert-worthy slippage event.
SLIPPAGE_ALERT_PCT=0.15

# --- Nightly autotune (app/autotune.py) ---------------------------------------
# Grid-searches take_profit_pct over the last AUTOTUNE_LOOKBACK_DAYS once a
# day and reports whether a different value scores a better profit factor.
# Suggest-only by default — AUTOTUNE_AUTO_APPLY=false means the dashboard
# shows the recommendation but never mutates a live risk setting on its own;
# a 14-day sample is small and noisy enough that auto-applying is a real
# overfitting risk in its own right. Only runs when FUTURES_ENABLED=true
# (the backtest engine it uses is futures-shaped).
AUTOTUNE_ENABLED=true
AUTOTUNE_AUTO_APPLY=false
AUTOTUNE_HOUR_UTC=2
AUTOTUNE_LOOKBACK_DAYS=14
AUTOTUNE_TP_CANDIDATES=1.0,1.2,1.4
AUTOTUNE_MIN_PF_IMPROVEMENT_MULTIPLE=1.2

# --- Dashboard / API security -------------------------------------------------
# Random long secret used to authenticate the frontend against this backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_TOKEN=change-me-to-a-long-random-secret

# Comma-separated list of allowed CORS origins (your Vercel frontend URL).
CORS_ORIGINS=http://localhost:3000

# --- Persistence & logging ----------------------------------------------------
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO

# Port the API server listens on (Railway/Render inject PORT automatically).
PORT=8000
