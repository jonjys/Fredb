# =============================================================================
# TRADING BOT — FRONTEND ENVIRONMENT VARIABLES
# Copy to ".env.local" for local dev. In production, set these as
# Environment Variables in the Vercel project dashboard.
#
# IMPORTANT: these are server-only (no NEXT_PUBLIC_ prefix), so they are
# NEVER sent to the browser. The browser only ever calls this app's own
# /api/* routes, which proxy to the backend server-side and attach the
# secret token there. This is how API keys stay out of the frontend.
# =============================================================================

# URL of the backend API (Railway/Render deployment), no trailing slash.
BACKEND_URL=http://localhost:8000

# Must match DASHBOARD_API_TOKEN configured on the backend.
DASHBOARD_API_TOKEN=change-me-to-a-long-random-secret
